# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
PORT=3000
NODE_ENV=development

# Bắt buộc
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
DB_PASSWORD=
MQTT_USERNAME=ten-tai-khoan-adafruit
MQTT_KEY=aio_xxxxxxxxxxxxxxxxxxxxxxxx

# Cơ sở dữ liệu
DB_HOST=localhost
DB_USER=root
DB_NAME=smart_home
DB_PORT=3306

# Khoá cho Gateway / camera / bàn phím gọi API bằng header x-iot-key (để trống = tắt)
IOT_API_KEY=
# Nhà gắn phần cứng thật (để trống = nhà có Home_ID nhỏ nhất)
MQTT_HOME_ID=
# Số giây cửa tự khoá lại (0 = tắt)
DOOR_AUTO_LOCK_SECONDS=10
# Không thấy người (PIR) bao nhiêu phút thì tự tắt đèn
LIGHT_NO_MOTION_MINUTES=2
# Danh sách origin Frontend, cách nhau dấu phẩy (để trống = mặc định localhost:3000/8000/5500/5173)
CORS_ORIGIN=
